# Free Supabase project: https://supabase.com  (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# M-Pesa (Safaricom Daraja) - https://developer.safaricom.co.ke
MPESA_ENV=sandbox                  # "production" when you go live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_SECRET=             # any long random string; must match private.secrets 'mpesa_callback' in the database
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Production only (sandbox uses Safaricom's public test values):
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_TXN_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till number
